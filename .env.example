# Copy to .env (never commit .env)
FIRECRAWL_API_KEY=fc-your-key-here
UNPLUG_API_KEYS=

# Optional: local ML checkpoint for tests/audit (otherwise ML tests skip)
# UNPLUG_TEST_CHECKPOINT=/path/to/checkpoint-slim
# UNPLUG_MODEL_PATH=/path/to/checkpoint-slim

# Optional: directory with local probe-query overrides
# UNPLUG_PROBES_DIR=/path/to/probe-configs
